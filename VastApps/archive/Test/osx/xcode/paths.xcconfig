#include "local.xcconfig"
#include "../../src/version.txt"

// Add to target preprocessor defs as $(inherited)
GCC_PREPROCESSOR_DEFINITIONS = DEVELOPER_FILE_SYSTEM_ROOT=$(DEVELOPER_FILE_SYSTEM_ROOT) MINOR_VERSION=$MINOR_VERSION MAJOR_VERSION=$MAJOR_VERSION DISTRIBUTION_VERSION=$DISTRIBUTION_VERSION _NOMEMORYMANAGER=1 VFP_NO_THUMB